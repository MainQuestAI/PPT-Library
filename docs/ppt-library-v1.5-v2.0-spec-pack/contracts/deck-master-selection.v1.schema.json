{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-library.local/contracts/deck-master-selection.v1.schema.json",
  "title": "Deck Master PPT Library Selection v1 (Vendored Compatibility Draft)",
  "type": "object",
  "required": [
    "schema_version",
    "run_id"
  ],
  "properties": {
    "schema_version": {
      "const": "deck_master_ppt_library_selection.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "producer_version": {
      "type": "string"
    },
    "selections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "by_beat": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "selections"
      ]
    },
    {
      "required": [
        "by_beat"
      ]
    },
    {
      "required": [
        "beats"
      ]
    }
  ],
  "$defs": {
    "selection": {
      "type": "object",
      "required": [
        "candidates"
      ],
      "properties": {
        "beat_id": {
          "type": "string"
        },
        "page_task_id": {
          "type": "string"
        },
        "slot_id": {
          "type": "string"
        },
        "query_trace_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "beat_id"
          ]
        },
        {
          "required": [
            "page_task_id"
          ]
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
