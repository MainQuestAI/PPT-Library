{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-library.local/contracts/deck-master-bridge-plan.v1.schema.json",
  "title": "Deck Master PPT Library Bridge Plan v1",
  "type": "object",
  "required": ["schema_version", "run_id", "requests"],
  "properties": {
    "schema_version": {"const": "deck_master_ppt_library_bridge_plan.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/request"}
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "beat_id", "page_task_id", "query_trace_id", "role_original",
        "role_strategy", "role_mapped", "query", "reuse_policy"
      ],
      "properties": {
        "beat_id": {"type": "string", "minLength": 1},
        "page_task_id": {"type": "string", "minLength": 1},
        "query_trace_id": {"type": "string", "minLength": 1},
        "role_original": {"type": "string", "minLength": 1},
        "role_strategy": {"type": "string", "minLength": 1},
        "role_mapped": {
          "enum": ["opener", "problem", "solution", "architecture", "case", "roi", "cta", "appendix"]
        },
        "query": {"type": "string", "minLength": 1},
        "reuse_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
